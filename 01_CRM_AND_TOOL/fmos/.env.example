# ============================================================================
# FMOS environment variables — copy to .env.local and fill in.
# Never commit real secrets. .env.local is gitignored; this file is the template.
# "Required" = the app/feature breaks without it. "Optional" = dormant until set.
# ============================================================================

# ── Supabase (REQUIRED) ─────────────────────────────────────────────────────
# Public values are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Used by cron jobs, webhooks, and public
# lead/report flows. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (REQUIRED for strategy/report AI features) ───────────────────────────
# Anthropic API key. Used server-side only (lib/anthropic.ts, strategy actions,
# daily report). If unset, AI features no-op / fall back.
ANTHROPIC_API_KEY=sk-ant-...

# ── Cron auth (REQUIRED in production) ──────────────────────────────────────
# Shared secret for /api/cron/* routes. Cron endpoints return 503 until set.
# Must match the value in the GitHub Actions secret (see .github/workflows/cron.yml).
CRON_SECRET=generate-a-long-random-string

# ── Inbound webhooks (REQUIRED for /api/inbound/*) ──────────────────────────
INBOUND_WEBHOOK_SECRET=generate-a-long-random-string

# ── WhatsApp Cloud API (OPTIONAL — leave blank until Meta/WABA is live) ──────
# Permanent token + phone number id from the Meta WhatsApp Cloud API app.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook handshake verify token (you choose this; must match Meta App config).
WHATSAPP_VERIFY_TOKEN=
# Meta App secret — used to verify inbound webhook signatures.
META_APP_SECRET=
# Fallback landing-page URL sent when a CTWA/click-to-WhatsApp lead has no
# specific landing page resolved.
WHATSAPP_LP_FALLBACK_URL=

# ── Outcome-driven outbound WhatsApp (OPTIONAL) ─────────────────────────────
# JSON map of call-outcome key -> Meta-APPROVED template name. When a call
# outcome is logged, the mapped template (if any) is sent to the lead.
# Cold outbound requires an APPROVED template (24h session text won't do).
# Unset = feature disabled (warns once in production). Example:
#   WA_OUTCOME_TEMPLATES={"interested":"intro_followup","callback_scheduled":"callback_reminder"}
WA_OUTCOME_TEMPLATES=
# Template language code (default: en).
WA_OUTCOME_TEMPLATE_LANG=en

# ── Daily AI report → admin WhatsApp (OPTIONAL) ─────────────────────────────
# Comma-separated admin WhatsApp numbers (E.164, e.g. 919876543210).
ADMIN_WHATSAPP_NUMBERS=
# Meta-approved template name + language for the daily report message.
DAILY_REPORT_TEMPLATE=
DAILY_REPORT_TEMPLATE_LANG=en

# ── Build / runtime (OPTIONAL) ──────────────────────────────────────────────
# Override the Next.js build output dir (next.config.ts). Leave unset for default.
NEXT_DIST_DIR=
