# ──────────────────────────────────────────────────────────────────────────
# FMOS — STAGING / E2E environment
# Copy to `.env.staging` and fill with your STAGING Supabase project values.
# NEVER point this at the production project (cnwooodktqwvpzkucskm) — the E2E
# DB fixture hard-refuses to run against that ref.
# ──────────────────────────────────────────────────────────────────────────

# Staging Supabase project (its OWN ref — must NOT be cnwooodktqwvpzkucskm)
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# App URL the tests hit
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Serve the FMOS APP (not the marketing site) on localhost during E2E.
# .env.local sets MARKETING_PREVIEW_LOCAL=1 for local marketing preview, and Next's
# dev server auto-loads .env.local — so we MUST force it off here or every app route
# (/login, /admin, …) gets host-split to the marketing site and 404s.
MARKETING_PREVIEW_LOCAL=0

# ── External integrations: keep INERT on staging so tests never reach the world ──
# WhatsApp: test mode + empty token => sends are logged/dropped, never delivered.
WHATSAPP_SEND_MODE=test
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=staging-not-used
# AI: optional. Leave blank to exercise the deterministic fallbacks; set a real
# key only if you want to test the AI-summary/brief/strategy paths on staging.
ANTHROPIC_API_KEY=
# Secrets for cron / inbound webhook tests (any value works on staging)
CRON_SECRET=staging-cron-secret
INBOUND_WEBHOOK_SECRET=staging-inbound-secret
# Google Calendar: leave blank so bookMeeting skips the real calendar call.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Seed test users (created by scripts/seed-staging.mjs in the staging auth) ──
E2E_ADMIN_EMAIL=e2e-admin@fmos.test
E2E_ADMIN_PASSWORD=E2e!StagingPass1
E2E_TELECALLER_EMAIL=e2e-caller@fmos.test
E2E_TELECALLER_PASSWORD=E2e!StagingPass1
